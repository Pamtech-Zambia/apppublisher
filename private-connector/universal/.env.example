# PRIVATE hosting only. No package names or shared service account!
MCP_PUBLIC_URL=https://pamtech-play-private-connector.vercel.app
AUTH_ISSUER=https://YOUR-AUTH0-DOMAIN/
AUTH_AUDIENCE=https://pamtech-play-private-connector.vercel.app/api/mcp
# Separate Auth0 Regular Web Application for browser ownership verification
AUTH0_WEB_CLIENT_ID=
AUTH0_WEB_CLIENT_SECRET=
# Google Cloud OAuth client of type Web application
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Private managed Postgres, initialized with schema.sql
DATABASE_URL=
# Generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store only in encrypted Vercel production environment settings
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Generate separately with python -c "import secrets; print(secrets.token_urlsafe(48))"
PLAY_APPROVAL_SIGNING_KEY=
# Never enable until full live auth, permission, and review tests pass
PLAY_ENABLE_TEST_WRITES=NO
# Deprecated in v0.7; should be removed after deploying v0.7 and verifying health
# PLAY_SUBJECT_PACKAGES_JSON
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
